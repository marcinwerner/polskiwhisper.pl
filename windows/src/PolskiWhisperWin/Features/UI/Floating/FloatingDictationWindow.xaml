<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="PolskiWhisperWin.Features.UI.Floating.FloatingDictationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    xmlns:floating="using:PolskiWhisperWin.Features.UI.Floating"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markupcompatibility/2006"
    Title="PolskiWhisper - Dictation"
    Width="320"
    Height="80"
    mc:Ignorable="d">

    <Border CornerRadius="20"
            Padding="16,12,16,12"
            BorderThickness="1">
        <Border.Background>
            <AcrylicBrush TintColor="Black" TintOpacity="0.65" FallbackColor="#222222" />
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#33FFFFFF" />
        </Border.BorderBrush>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="StatusIcon"
                      Grid.Column="0"
                      Glyph="&#xE720;"
                      FontSize="20"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      Foreground="#FFFFFFFF" />

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <floating:WaveformView x:Name="Waveform" />
                <ProgressRing x:Name="ProcessingRing"
                              Width="24" Height="24"
                              IsActive="False"
                              Visibility="Collapsed"
                              Foreground="#FFFFFFFF" />
                <TextBlock x:Name="StatusText"
                           Text=""
                           Foreground="#FFFFFFFF"
                           FontSize="13"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>

            <TextBlock x:Name="HintLabel"
                       Grid.Column="2"
                       Text="Esc"
                       Margin="12,0,0,0"
                       Padding="6,2,6,2"
                       FontSize="10"
                       Foreground="#AAFFFFFF"
                       VerticalAlignment="Center"
                       Background="#22FFFFFF" />
        </Grid>
    </Border>
</winuiex:WindowEx>
