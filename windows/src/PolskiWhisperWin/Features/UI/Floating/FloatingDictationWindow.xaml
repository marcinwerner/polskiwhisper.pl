<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PolskiWhisperWin.Features.UI.Floating.FloatingDictationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:floating="using:PolskiWhisperWin.Features.UI.Floating">

    <Border CornerRadius="20"
            Padding="16,12,16,12"
            BorderThickness="1"
            Background="#E62A2A2A"
            BorderBrush="#33FFFFFF">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="StatusIcon"
                      Grid.Column="0"
                      Glyph="&#xE720;"
                      FontSize="20"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      Foreground="#FFFFFFFF" />

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <floating:WaveformView x:Name="Waveform" />
                <ProgressRing x:Name="ProcessingRing"
                              Width="24" Height="24"
                              IsActive="False"
                              Visibility="Collapsed"
                              Foreground="#FFFFFFFF" />
                <TextBlock x:Name="StatusText"
                           Text=""
                           Foreground="#FFFFFFFF"
                           FontSize="13"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>

            <Border x:Name="HintLabel"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="6,2,6,2"
                    Background="#22FFFFFF"
                    CornerRadius="4"
                    VerticalAlignment="Center">
                <TextBlock Text="Esc"
                           FontSize="10"
                           Foreground="#AAFFFFFF" />
            </Border>
        </Grid>
    </Border>
</Window>
