<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PolskiWhisperWin.Features.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header z tytułem + skrótem klawiszowym -->
        <Border Grid.Row="0"
                Padding="24,16,24,16"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="PolskiWhisper"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="VersionLabel"
                           Text="v0.1.0"
                           FontSize="12"
                           Opacity="0.6"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- NavigationView z 4 zakładkami Settings -->
        <NavigationView Grid.Row="1"
                        x:Name="MainNav"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="MainNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="general" Content="Ogólne">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="whisper" Content="Whisper">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE720;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="vocabulary" Content="Słownik">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="about" Content="O programie">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
