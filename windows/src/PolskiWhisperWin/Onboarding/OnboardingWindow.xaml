<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PolskiWhisperWin.Onboarding.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="32,24,32,16">
            <StackPanel Spacing="8">
                <TextBlock x:Name="StepLabel"
                           Text="Krok 1 z 5"
                           Opacity="0.6"
                           FontSize="12" />
                <TextBlock x:Name="TitleLabel"
                           Text="Witaj w PolskiWhisper!"
                           FontSize="28"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="32,16,32,16">
            <Frame x:Name="ContentFrame" />
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="32,16,32,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Content="Wstecz"
                        IsEnabled="False"
                        Click="BackButton_Click" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SkipButton"
                            Content="Pomiń"
                            Click="SkipButton_Click" />
                    <Button x:Name="NextButton"
                            Content="Dalej"
                            Click="NextButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
