<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PolskiWhisperWin.Onboarding.Steps.FinishStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="16" MaxWidth="600">
        <TextBlock TextWrapping="Wrap" FontSize="16" Opacity="0.9">
            Wszystko gotowe! Aplikacja będzie chodziła w tle - znajdziesz ją w pasku zadań (system tray).
        </TextBlock>

        <Border Padding="16"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorTertiaryBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="Jak zacząć dyktować?" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap">1. Kliknij w pole tekstowe w którym chcesz wkleić tekst (np. e-mail, edytor).</TextBlock>
                <TextBlock TextWrapping="Wrap">2. Naciśnij wybrany skrót klawiszowy.</TextBlock>
                <TextBlock TextWrapping="Wrap">3. Mów po polsku - widget pokaże poziom dźwięku.</TextBlock>
                <TextBlock TextWrapping="Wrap">4. Naciśnij skrót ponownie - tekst pojawi się automatycznie.</TextBlock>
            </StackPanel>
        </Border>

        <Border Padding="16"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorTertiaryBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="Wskazówki" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap">• Esc anuluje nagrywanie bez wklejania.</TextBlock>
                <TextBlock TextWrapping="Wrap">• Po kropce, wykrzykniku lub pytajniku aplikacja sama doda spację przed kolejnym fragmentem.</TextBlock>
                <TextBlock TextWrapping="Wrap">• Jeśli Whisper przekręci jakieś słowo - dodaj regułę w zakładce Słownik.</TextBlock>
                <TextBlock TextWrapping="Wrap">• Możesz zmienić wszystko w Ustawieniach (klik w ikonę w tray).</TextBlock>
            </StackPanel>
        </Border>

        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12">
            Kliknij "Zakończ" aby przejść do dyktowania. Aplikacja zostanie w tle.
        </TextBlock>
    </StackPanel>
</Page>
