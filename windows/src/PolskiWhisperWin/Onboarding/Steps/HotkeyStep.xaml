<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PolskiWhisperWin.Onboarding.Steps.HotkeyStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="16" MaxWidth="600">
        <TextBlock TextWrapping="Wrap" FontSize="14" Opacity="0.9">
            Wybierz klawisz, którym będziesz uruchamiać dyktowanie. Domyślnie - prawy Ctrl (rzadko używany w aplikacjach).
        </TextBlock>

        <ComboBox x:Name="HotkeyComboBox"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="HotkeyComboBox_SelectionChanged" />

        <Border Padding="16"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorTertiaryBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="Tryb działania" FontWeight="SemiBold" />
                <RadioButton x:Name="ToggleModeRadio"
                             GroupName="HotkeyMode"
                             IsChecked="True"
                             Content="Toggle - krótki tap włącza/wyłącza nagrywanie" />
                <RadioButton x:Name="HoldModeRadio"
                             GroupName="HotkeyMode"
                             Content="Hold - trzymaj klawisz aby nagrywać (push-to-talk)" />
            </StackPanel>
        </Border>

        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12">
            Możesz nacisnąć Esc w trakcie nagrywania, aby anulować bez wklejania.
        </TextBlock>
    </StackPanel>
</Page>
