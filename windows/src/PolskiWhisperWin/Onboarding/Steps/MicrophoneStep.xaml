<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PolskiWhisperWin.Onboarding.Steps.MicrophoneStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="16" MaxWidth="600">
        <TextBlock TextWrapping="Wrap" FontSize="14" Opacity="0.9"
                   Text="Wybierz mikrofon, którego chcesz używać. Później możesz zmienić w ustawieniach." />

        <ComboBox x:Name="MicrophoneComboBox"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="Wybierz mikrofon"
                  SelectionChanged="MicrophoneComboBox_SelectionChanged" />

        <Border Padding="16"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorTertiaryBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="🎤 Test mikrofonu" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Opacity="0.85"
                           Text="Powiedz coś - poziom dźwięku powinien rosnąć:" />
                <ProgressBar x:Name="LevelBar" Maximum="100" Value="0" Height="20" />
                <Button x:Name="TestButton"
                        Content="Rozpocznij test"
                        Click="TestButton_Click"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
