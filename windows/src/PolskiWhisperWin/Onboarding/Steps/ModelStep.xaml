<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PolskiWhisperWin.Onboarding.Steps.ModelStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markupcompatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="16" MaxWidth="600">
        <TextBlock TextWrapping="Wrap" FontSize="14" Opacity="0.9">
            Polecamy Whisper Turbo (1.5 GB) - bardzo dobry kompromis jakości i szybkości dla polskiego.
        </TextBlock>

        <Border Padding="16"
                CornerRadius="8"
                BorderThickness="2"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="Whisper Turbo (1.5 GB)" FontWeight="SemiBold" FontSize="16" />
                <TextBlock TextWrapping="Wrap" Opacity="0.85"
                           Text="Najlepsza jakość polskiego w rozsądnym czasie. Pobranie zajmie ~5 minut na typowym łączu." />
                <Button x:Name="DownloadButton"
                        Content="Pobierz teraz"
                        Click="DownloadButton_Click"
                        HorizontalAlignment="Left" />
                <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Visibility="Collapsed" Opacity="0.85" />
            </StackPanel>
        </Border>

        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12">
            Możesz pominąć ten krok i pobrać model później w ustawieniach. Model jest wymagany przed pierwszym dyktowaniem.
        </TextBlock>
    </StackPanel>
</Page>
