<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PolskiWhisperWin.Onboarding.Steps.WelcomeStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markupcompatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="16" MaxWidth="600">
        <TextBlock TextWrapping="Wrap" FontSize="16" Opacity="0.9">
            PolskiWhisper to darmowa aplikacja do dyktowania głosowego po polsku. Działa w pełni offline po pobraniu modelu.
        </TextBlock>

        <TextBlock TextWrapping="Wrap" Opacity="0.85">
            W kilku krokach skonfigurujemy:
        </TextBlock>

        <StackPanel Margin="16,0,0,0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE720;" FontSize="16" />
                <TextBlock Text="Mikrofon - urządzenie do nagrywania" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE896;" FontSize="16" />
                <TextBlock Text="Model Whisper - silnik rozpoznawania mowy" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE765;" FontSize="16" />
                <TextBlock Text="Skrót klawiszowy - klawisz uruchamiający dyktowanie" />
            </StackPanel>
        </StackPanel>

        <Border Margin="0,16,0,0" Padding="16"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorTertiaryBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="🔒 Prywatność" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Opacity="0.85">
                    Aplikacja działa lokalnie - nagrania nie są wysyłane do żadnego serwera. Jedyne połączenia sieciowe to pobieranie modelu Whisper z Hugging Face oraz sprawdzanie nowych wersji aplikacji (raz na dobę).
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
