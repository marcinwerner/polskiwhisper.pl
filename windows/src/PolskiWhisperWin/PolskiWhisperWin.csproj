<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>PolskiWhisperWin</RootNamespace>
    <AssemblyName>PolskiWhisper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- Wyłączenie MRT/PRI tools (wymagaja Visual Studio MSBuild, nie czysty .NET SDK na CI). -->
    <EnableDefaultPriItems>false</EnableDefaultPriItems>
    <DisableMrtIfNoSchemaInstaller>true</DisableMrtIfNoSchemaInstaller>
    <DisableEmbeddedXbf>true</DisableEmbeddedXbf>
    <GenerateLibraryLayout>false</GenerateLibraryLayout>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ApplicationIcon: dodać Assets\AppIcon.ico przed pierwszym MSI release. -->
    <!-- <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon> -->

    <AssemblyTitle>PolskiWhisper</AssemblyTitle>
    <Authors>Marcin Werner</Authors>
    <Company>marcinwerner.com</Company>
    <Product>PolskiWhisper</Product>
    <Copyright>Copyright © 2026 Marcin Werner</Copyright>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <NeutralLanguage>pl-PL</NeutralLanguage>
    <RollForward>LatestMajor</RollForward>
    <PublishProfile>Properties\PublishProfiles\win-x64.pubxml</PublishProfile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240627000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SharpHook" Version="5.3.7" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
    <PackageReference Include="InputSimulatorPlus" Version="1.0.7" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="2.0.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="3.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolskiWhisperWin.Core\PolskiWhisperWin.Core.csproj" />
  </ItemGroup>

  <!--
    Iteracyjna reaktywacja komponentów XAML wyłączonych w v0.1.0-preview.
    Każdy commit reaktywuje 1 komponent + push + sprawdzenie CI.
    Aktywne (compiled): WaveformView (od 2026-05-09).
    Wyłączone: pozostałe XAML pages + .cs (poniżej).
  -->
  <ItemGroup>
    <Page Remove="Features\UI\Pages\WhisperSettingsPage.xaml" />
    <Page Remove="Features\UI\Pages\VocabularySettingsPage.xaml" />
    <Page Remove="Features\UI\Floating\FloatingDictationWindow.xaml" />
    <Page Remove="Onboarding\OnboardingWindow.xaml" />
    <Page Remove="Onboarding\Steps\WelcomeStep.xaml" />
    <Page Remove="Onboarding\Steps\MicrophoneStep.xaml" />
    <Page Remove="Onboarding\Steps\ModelStep.xaml" />
    <Page Remove="Onboarding\Steps\HotkeyStep.xaml" />
    <Page Remove="Onboarding\Steps\FinishStep.xaml" />

    <Compile Remove="Features\UI\Pages\WhisperSettingsPage.xaml.cs" />
    <Compile Remove="Features\UI\Pages\VocabularySettingsPage.xaml.cs" />
    <Compile Remove="Features\UI\Floating\FloatingDictationWindow.xaml.cs" />
    <Compile Remove="Onboarding\**\*.cs" />

    <None Include="Features\UI\Pages\WhisperSettingsPage.xaml" />
    <None Include="Features\UI\Pages\WhisperSettingsPage.xaml.cs" />
    <None Include="Features\UI\Pages\VocabularySettingsPage.xaml" />
    <None Include="Features\UI\Pages\VocabularySettingsPage.xaml.cs" />
    <None Include="Features\UI\Floating\FloatingDictationWindow.xaml" />
    <None Include="Features\UI\Floating\FloatingDictationWindow.xaml.cs" />
    <None Include="Onboarding\**\*.xaml" />
    <None Include="Onboarding\**\*.cs" />
  </ItemGroup>

  <!-- Wszystkie .cs services aktywne od 2026-05-09: SoundService, NotificationDispatcher, TrayIconController. -->


  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" Condition="Exists('Assets\AppIcon.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\TrayIcon.ico" Condition="Exists('Assets\TrayIcon.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\launchSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

</Project>
